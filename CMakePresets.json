{
	"version": 3,
	"configurePresets": [
		{
			"name": "base",
			"hidden": true,
			"description": "Base configuration for all platforms. LTO defaults to OFF for safety; enable via preset inheritance or -DENABLE_LTO=ON",
			"generator": "Ninja",
			"cacheVariables": {
				"CMAKE_CXX_STANDARD": "23",
				"CMAKE_CXX_STANDARD_REQUIRED": "ON",
				"CMAKE_CXX_EXTENSIONS": "OFF",
				"CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
				"ENABLE_CCACHE": "ON",
				"ENABLE_LTO": "OFF"
			}
		},
		{
			"name": "debug",
			"hidden": true,
			"cacheVariables": {
				"CMAKE_BUILD_TYPE": "Debug",
				"ENABLE_LTO": "OFF"
			}
		},
		{
			"name": "relwithdebinfo",
			"hidden": true,
			"cacheVariables": {
				"CMAKE_BUILD_TYPE": "RelWithDebInfo",
				"ENABLE_LTO": "ON"
			}
		},
		{
			"name": "release",
			"hidden": true,
			"cacheVariables": {
				"CMAKE_BUILD_TYPE": "Release",
				"ENABLE_LTO": "ON"
			}
		},
		{
			"name": "ci-pr",
			"hidden": true,
			"description": "CI preset for Pull Requests: disabled LTO for speed",
			"inherits": [ "base" ],
			"cacheVariables": {
				"ENABLE_LTO": "OFF"
			}
		},
		{
			"name": "ci-release",
			"hidden": true,
			"description": "CI preset for Release builds (main/development): enabled LTO",
			"inherits": [ "base" ],
			"cacheVariables": {
				"ENABLE_LTO": "ON"
			}
		},
		{
			"name": "windows",
			"hidden": true,
			"condition": {
				"type": "equals",
				"lhs": "${hostSystemName}",
				"rhs": "Windows"
			}
		},
		{
			"name": "linux",
			"hidden": true,
			"condition": {
				"type": "equals",
				"lhs": "${hostSystemName}",
				"rhs": "Linux"
			}
		},
		{
			"name": "msvc",
			"hidden": true,
			"inherits": [
				"windows"
			],
			"cacheVariables": {
				"CMAKE_C_COMPILER": "cl",
				"CMAKE_CXX_COMPILER": "cl",
				"CMAKE_CXX_FLAGS_INIT": "/WX /Zc:inline /Zc:__cplusplus /Zc:enumTypes /Zc:templateScope /Zc:throwingNew /guard:cf",
				"CMAKE_CXX_FLAGS_RELEASE_INIT": "/O2 /Oi /fp:fast /GF /Gy /Ot /Ob3 /Gw /GL",
				"CMAKE_CXX_FLAGS_DEBUG_INIT": "/Od /Zi /sdl /GS",
				"CMAKE_EXE_LINKER_FLAGS": "/stack:10000000"
			}
		},
		{
			"name": "clang-cl",
			"hidden": true,
			"inherits": [
				"windows"
			],
			"cacheVariables": {
				"CMAKE_C_COMPILER": "clang-cl",
				"CMAKE_CXX_COMPILER": "clang-cl",
				"CMAKE_EXE_LINKER_FLAGS": "/stack:10000000"
			}
		},
		{
			"name": "clang",
			"hidden": true,
			"cacheVariables": {
				"CMAKE_C_COMPILER": "clang",
				"CMAKE_CXX_COMPILER": "clang++",
				"CMAKE_MSVC_RUNTIME_LIBRARY": "MultiThreadedDLL"
			}
		},
		{
			"name": "gcc",
			"hidden": true,
			"cacheVariables": {
				"CMAKE_C_COMPILER": "gcc",
				"CMAKE_CXX_COMPILER": "g++"
			}
		},
		{
			"name": "asan-windows-msvc",
			"hidden": true,
			"cacheVariables": {
				"CMAKE_C_FLAGS": "/fsanitize=address",
				"CMAKE_CXX_FLAGS": "/fsanitize=address",
				"CMAKE_EXE_LINKER_FLAGS": "/stack:10000000 /INCREMENTAL:NO /DEBUG",
				"CMAKE_EXE_LINKER_FLAGS_DEBUG": "/DEBUG /INCREMENTAL:NO",
				"CMAKE_SHARED_LINKER_FLAGS": "/INCREMENTAL:NO /DEBUG",
				"CMAKE_SHARED_LINKER_FLAGS_DEBUG": "/DEBUG /INCREMENTAL:NO",
				"CMAKE_CXX_LINKER_FLAGS": "/INCREMENTAL:NO /DEBUG",
				"USE_MIMALLOC": "OFF",
				"SANITISE": "ON"
			}
		},
		{
			"name": "asan-linux",
			"hidden": true,
			"cacheVariables": {
				"CMAKE_CXX_FLAGS": "-fsanitize=address,undefined -fno-sanitize-recover=all",
				"CMAKE_EXE_LINKER_FLAGS": "-fsanitize=address,undefined",
				"USE_MIMALLOC": "OFF",
				"SANITISE": "ON"
			}
		},
		{
			"name": "Win64-MSVC-Debug",
			"displayName": "Windows x64 / MSVC / Debug",
			"inherits": [
				"base",
				"windows",
				"debug"
			],
			"binaryDir": "${sourceDir}/out/build/Win64-Debug-MSVC",
			"cacheVariables": {
				"CMAKE_TOOLCHAIN_FILE": "cmake/toolchains/msvc/windows.cmake",
				"CMAKE_INSTALL_PREFIX": "${sourceDir}/out/install/Win64-Debug-MSVC",
				"CMAKE_MSVC_RUNTIME_LIBRARY": "MultiThreadedDebug"
			}
		},
		{
			"name": "Win64-MSVC-Debug-ASan",
			"displayName": "Windows x64 / MSVC / Debug / ASan",
			"inherits": [
				"Win64-MSVC-Debug",
				"asan-windows-msvc"
			],
			"binaryDir": "${sourceDir}/out/build/Win64-Debug-MSVC-ASan",
			"cacheVariables": {
				"CMAKE_INSTALL_PREFIX": "${sourceDir}/out/install/Win64-Debug-MSVC-ASan"
			}
		},
		{
			"name": "Win64-MSVC-Release",
			"displayName": "Windows x64 / MSVC / RelWithDebInfo",
			"inherits": [
				"base",
				"windows",
				"relwithdebinfo"
			],
			"binaryDir": "${sourceDir}/out/build/Win64-Release-MSVC",
			"cacheVariables": {
				"CMAKE_TOOLCHAIN_FILE": "cmake/toolchains/msvc/windows.cmake",
				"CMAKE_INSTALL_PREFIX": "${sourceDir}/out/install/Win64-Release-MSVC",
				"CMAKE_MSVC_RUNTIME_LIBRARY": "MultiThreaded"
			}
		},
		{
			"name": "Win64-Clang-cl-Debug",
			"displayName": "Windows x64 / Clang-cl / Debug",
			"inherits": [
				"base",
				"windows",
				"debug"
			],
			"binaryDir": "${sourceDir}/out/build/Win64-Clang-cl-Debug",
			"cacheVariables": {
				"CMAKE_TOOLCHAIN_FILE": "cmake/toolchains/clang-cl/windows.cmake",
				"CMAKE_INSTALL_PREFIX": "${sourceDir}/out/install/Win64-Clang-cl-Debug"
			}
		},
		{
			"name": "Win64-Clang-cl-Release",
			"displayName": "Windows x64 / Clang-cl / RelWithDebInfo",
			"inherits": [
				"base",
				"windows",
				"relwithdebinfo"
			],
			"binaryDir": "${sourceDir}/out/build/Win64-Clang-cl-Release",
			"cacheVariables": {
				"CMAKE_TOOLCHAIN_FILE": "cmake/toolchains/clang-cl/windows.cmake",
				"CMAKE_INSTALL_PREFIX": "${sourceDir}/out/install/Win64-Clang-cl-Release"
			}
		},
		{
			"name": "Win64-Clang-Debug",
			"displayName": "Windows x64 / Clang / Debug",
			"inherits": [
				"base",
				"windows",
				"debug"
			],
			"binaryDir": "${sourceDir}/out/build/Win64-Clang-Debug",
			"cacheVariables": {
				"CMAKE_TOOLCHAIN_FILE": "cmake/toolchains/clang/windows.cmake",
				"CMAKE_INSTALL_PREFIX": "${sourceDir}/out/install/Win64-Clang-Debug"
			}
		},
		{
			"name": "Win64-Clang-Release",
			"displayName": "Windows x64 / Clang / RelWithDebInfo",
			"inherits": [
				"base",
				"windows",
				"relwithdebinfo"
			],
			"binaryDir": "${sourceDir}/out/build/Win64-Clang-Release",
			"cacheVariables": {
				"CMAKE_TOOLCHAIN_FILE": "cmake/toolchains/clang/windows.cmake",
				"CMAKE_INSTALL_PREFIX": "${sourceDir}/out/install/Win64-Clang-Release"
			}
		},
		{
			"name": "Win64-GCC-Debug",
			"displayName": "Windows x64 / GCC / Debug",
			"inherits": [
				"base",
				"windows",
				"debug"
			],
			"binaryDir": "${sourceDir}/out/build/Win64-GCC-Debug",
			"cacheVariables": {
				"CMAKE_TOOLCHAIN_FILE": "cmake/toolchains/gcc/windows.cmake",
				"CMAKE_INSTALL_PREFIX": "${sourceDir}/out/install/Win64-GCC-Debug"
			}
		},
		{
			"name": "Win64-GCC-Release",
			"displayName": "Windows x64 / GCC / Release",
			"inherits": [
				"base",
				"windows",
				"relwithdebinfo"
			],
			"binaryDir": "${sourceDir}/out/build/Win64-GCC-Release",
			"cacheVariables": {
				"CMAKE_TOOLCHAIN_FILE": "cmake/toolchains/gcc/windows.cmake",
				"CMAKE_INSTALL_PREFIX": "${sourceDir}/out/install/Win64-GCC-Release"
			}
		},
		{
			"name": "Linux-Clang-Debug",
			"displayName": "Linux / Clang / Debug / UBSan",
			"inherits": [
				"base",
				"linux",
				"debug",
				"asan-linux"
			],
			"binaryDir": "${sourceDir}/out/build/linux-Clang-Debug",
			"cacheVariables": {
				"CMAKE_TOOLCHAIN_FILE": "cmake/toolchains/clang/linux.cmake",
				"CMAKE_INSTALL_PREFIX": "${sourceDir}/out/install/linux-Clang-Debug"
			}
		},
		{
			"name": "Linux-Clang-Release",
			"displayName": "Linux / Clang / Release / UBSan",
			"inherits": [
				"base",
				"linux",
				"release",
				"asan-linux"
			],
			"binaryDir": "${sourceDir}/out/build/linux-Clang-Release",
			"cacheVariables": {
				"CMAKE_TOOLCHAIN_FILE": "cmake/toolchains/clang/linux.cmake",
				"CMAKE_INSTALL_PREFIX": "${sourceDir}/out/install/linux-Clang-Release"
			}
		},
		{
			"name": "Linux-GCC-Debug",
			"displayName": "Linux / GCC / Debug",
			"inherits": [
				"base",
				"linux",
				"debug"
			],
			"binaryDir": "${sourceDir}/out/build/linux-GCC-Debug",
			"cacheVariables": {
				"CMAKE_TOOLCHAIN_FILE": "cmake/toolchains/gcc/linux.cmake",
				"CMAKE_INSTALL_PREFIX": "${sourceDir}/out/install/linux-GCC-Debug"
			}
		},
		{
			"name": "Linux-GCC-Release",
			"displayName": "Linux / GCC / Release",
			"inherits": [
				"base",
				"linux",
				"release"
			],
			"binaryDir": "${sourceDir}/out/build/linux-GCC-Release",
			"cacheVariables": {
				"CMAKE_TOOLCHAIN_FILE": "cmake/toolchains/gcc/linux.cmake",
				"CMAKE_INSTALL_PREFIX": "${sourceDir}/out/install/linux-GCC-Release"
			}
		},
		{
			"name": "Linux-Clang-Debug-ASan-UBSan",
			"displayName": "Linux / Clang / Debug / ASan+UBSan",
			"inherits": [
				"base",
				"linux",
				"debug",
				"asan-linux"
			],
			"binaryDir": "${sourceDir}/out/build/linux-Clang-Debug-ASan-UBSan",
			"cacheVariables": {
				"CMAKE_TOOLCHAIN_FILE": "cmake/toolchains/clang/linux.cmake",
				"CMAKE_INSTALL_PREFIX": "${sourceDir}/out/install/linux-Clang-Debug-ASan-UBSan"
			}
		},
		{
			"name": "Linux-Clang-Release-ASan-UBSan",
			"displayName": "Linux / Clang / Release / ASan+UBSan",
			"inherits": [
				"base",
				"linux",
				"release",
				"asan-linux"
			],
			"binaryDir": "${sourceDir}/out/build/linux-Clang-Release-ASan-UBSan",
			"cacheVariables": {
				"CMAKE_TOOLCHAIN_FILE": "cmake/toolchains/clang/linux.cmake",
				"CMAKE_INSTALL_PREFIX": "${sourceDir}/out/install/linux-Clang-Release-ASan-UBSan"
			}
		},
		{
			"name": "Linux-GCC-Debug-ASan-UBSan",
			"displayName": "Linux / GCC / Debug / ASan+UBSan",
			"inherits": [
				"base",
				"linux",
				"debug",
				"asan-linux"
			],
			"binaryDir": "${sourceDir}/out/build/linux-GCC-Debug-ASan-UBSan",
			"cacheVariables": {
