				"CMAKE_INSTALL_PREFIX": "${sourceDir}/out/install/linux-GCC-Debug-ASan-UBSan"
			}
		},
		{
			"name": "Linux-GCC-Release-ASan-UBSan",
			"displayName": "Linux / GCC / Release / ASan+UBSan",
			"inherits": [
				"base",
				"linux",
				"release",
				"asan-linux"
			],
			"binaryDir": "${sourceDir}/out/build/linux-GCC-Release-ASan-UBSan",
			"cacheVariables": {
				"CMAKE_TOOLCHAIN_FILE": "cmake/toolchains/gcc/linux.cmake",
				"CMAKE_INSTALL_PREFIX": "${sourceDir}/out/install/linux-GCC-Release-ASan-UBSan"
			}
		}
	],
	"buildPresets": [
		{
			"name": "Win64-MSVC-Debug-Build",
			"configurePreset": "Win64-MSVC-Debug"
		},
		{
			"name": "Win64-MSVC-Debug-ASan-Build",
			"configurePreset": "Win64-MSVC-Debug-ASan"
		},
		{
			"name": "Win64-MSVC-Release-Build",
			"configurePreset": "Win64-MSVC-Release"
		},
		{
			"name": "Win64-Clang-cl-Debug-Build",
			"configurePreset": "Win64-Clang-cl-Debug"
		},
		{
			"name": "Win64-Clang-cl-Release-Build",
			"configurePreset": "Win64-Clang-cl-Release"
		},
		{
			"name": "Win64-Clang-Debug-Build",
			"configurePreset": "Win64-Clang-Debug"
		},
		{
			"name": "Win64-Clang-Release-Build",
			"configurePreset": "Win64-Clang-Release"
		},
		{
			"name": "Win64-GCC-Debug-Build",
			"configurePreset": "Win64-GCC-Debug"
		},
		{
			"name": "Win64-GCC-Release-Build",
			"configurePreset": "Win64-GCC-Release"
		},
		{
			"name": "Linux-Clang-Debug-Build",
			"configurePreset": "Linux-Clang-Debug"
		},
		{
			"name": "Linux-Clang-Release-Build",
			"configurePreset": "Linux-Clang-Release"
		},
		{
			"name": "Linux-GCC-Debug-Build",
			"configurePreset": "Linux-GCC-Debug"
		},
		{
			"name": "Linux-GCC-Release-Build",
			"configurePreset": "Linux-GCC-Release"
		},
		{
			"name": "Linux-Clang-Debug-ASan-UBSan-Build",
