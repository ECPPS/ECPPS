add_library(ecpps_lto INTERFACE)

if(ENABLE_LTO)
    message(STATUS "[LTO] Link-Time Optimisation enabled")
    set(CMAKE_INTERPROCEDURAL_OPTIMIZATION OFF)
    set(CMAKE_INTERPROCEDURAL_OPTIMIZATION_RELEASE ON)
    
    if(MSVC)
        target_compile_options(ecpps_lto INTERFACE $<$<CONFIG:Release>:/GL>)
        target_link_options(ecpps_lto INTERFACE $<$<CONFIG:Release>:/LTCG>)
    else()
        target_compile_options(ecpps_lto INTERFACE $<$<CONFIG:Release>:-flto>)
        target_link_options(ecpps_lto INTERFACE $<$<CONFIG:Release>:-flto>)

        if(WIN32 AND CMAKE_CXX_COMPILER_ID STREQUAL "GNU")
            target_compile_options(ecpps_lto INTERFACE $<$<CONFIG:Release>:-Wa,-mbig-obj>)
        endif()
    endif()
else()
    message(STATUS "[LTO] Link-Time Optimisation disabled")
    set(CMAKE_INTERPROCEDURAL_OPTIMIZATION OFF)
    set(CMAKE_INTERPROCEDURAL_OPTIMIZATION_RELEASE OFF)
endif()
